{
  "expo": {
    "name": "simplyPet",
    "slug": "simplypet",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "de.simplypet.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F7F5F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Um den Impfpass zu fotografieren, braucht die App Zugriff auf deine Kamera. Das Foto bleibt in deiner Akte."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Um ein vorhandenes Tierfoto auszuwählen, braucht die App Zugriff auf die von dir ausgewählten Bilder."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 29
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
