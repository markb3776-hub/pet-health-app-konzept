{
  "expo": {
    "name": "simplyPet",
    "slug": "simplypet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "de.simplypet.app",
      "versionCode": 17,
      "adaptiveIcon": {
        "backgroundColor": "#F7F5F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_SPECIAL_USE",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Um den Impfpass zu fotografieren, braucht die App Zugriff auf deine Kamera. Das Foto bleibt in deiner Akte."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Um ein vorhandenes Tierfoto auszuwählen, braucht die App Zugriff auf die von dir ausgewählten Bilder."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 29
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4A6741",
          "defaultChannel": "reminders"
        }
      ],
      "expo-document-picker",
      "./plugins/withAndroidShortcuts",
      "./plugins/withForegroundService",
      "./plugins/withForegroundServiceBridge",
      "./plugins/withRegisterServicePackage",
      "./plugins/withShowOnLockScreen",
      "./plugins/withApkName",
      [
        "./plugins/withRemovePermissions",
        [
          "android.permission.DUMP"
        ]
      ]
    ],
    "ios": {
      "bundleIdentifier": "de.simplypet.app"
    }
  }
}
